# 生产环境 CSP：禁 eval、禁外链脚本/对象，仅允许同源脚本与资源
# 说明：Vant 需要 style 'unsafe-inline'；Lazyload 占位图来自 fastly.jsdelivr.net（img https: 已放行）
VITE_CSP=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https: http: ws: wss:; object-src 'none'; base-uri 'self'; form-action 'self'
