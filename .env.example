# 站点标题
VITE_APP_TITLE=Golden Finance

# 站点描述
VITE_APP_DESCRIPTION=个人财务管理工具

# 站点域名
VITE_SITE_URL=http://localhost

# 运行端口
VITE_PORT=5173

# Demo 模式开关（开启时显示演示提示、备案信息等辅助内容）
VITE_APP_DEMO=true

# API 基础地址
VITE_API_BASE_URL=http://localhost:your_Port/api/

# 文件上传基础路径
VITE_FILE_BASE_URL=http://localhost:your_Port/api/public

# 备案信息（仅非演示模式显示）
VITE_ICP_NUMBER=演ICP备XXXXXXXXX号
VITE_PSB_NUMBER=演公网安备XXXXXXXXX号

# 设备指纹盐（安全整改 P2-16）。参与 x-fingerprint-hash 的计算；
# 盐在前端代码中公开（防的是批量离线反推，不是保密），不同部署配不同值
# 可让跨站点的指纹枚举表失效。不配置时用内置默认值 live-fp-salt-v1。
# VITE_FP_SALT=openssl-rand-hex-16-推荐

# 站点品牌
VITE_BRAND_NAME=MyBrand
VITE_POWERED_BY=MyTeam
VITE_COPYRIGHT_START=2021

# ⚠ 演示模式默认账密请**不要**写在本文件（本文件对应 .env，所有 mode 都会加载）。
# Vite 会把 VITE_* 的值静态替换进产物 JS，写在 .env 里会导致明文账密进入生产 bundle。
# 如需本地演示预填，请放到只对 dev 生效的 `.env.development`：
#   VITE_LOGIN_USERNAME=admin
#   VITE_LOGIN_PASSWORD=********
